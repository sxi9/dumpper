{
  "manifest_version": 3,
  "name": "Dumper",
  "version": "2.1.0",
  "description": "Universal leak-site dumper: finds the victim list on any leak site (site profiles from leakwatch, generic card detection, custom selectors), groups by date, lets you tick victims and downloads one JSON dump for Claude.",
  "content_scripts": [
    {
      "matches": [
        "*://*.onion/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data.js",
        "panel.js"
      ],
      "matches": [
        "*://*.onion/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dumper@local"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Dumper \u2014 open/close the panel",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "activeTab"
  ]
}